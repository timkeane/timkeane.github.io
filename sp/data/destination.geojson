    {
      "type": "Feature",
      "properties": {
        "name": "Apiary",
        "category": "general",
        "info": "Bees play a vital role in our ecosystem by pollinating flowers, fruits, and vegetables, helping plants reproduce and our food systems thrive. Approximately one-third of the world’s food crops depend on bees to survive, so the next time you see a bee, don’t swat it – say thank you! By helping bees through our cared-for apiary, we are helping to protect biodiversity, healthy habitats, and the natural world we all depend on. Special thanks to our volunteer beekeeper, Jean-Marie Posner!",
        "url": null,
        "icon": "bee.svg"
      },
      "geometry": {
        "type": "Point",
        "coordinates": [-73.69806388856, 40.8622071664447]
      }
    },
