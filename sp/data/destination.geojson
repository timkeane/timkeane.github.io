    {
      "type": "Feature",
      "properties": {
        "name": "Entrance point to Trail 10",
        "category": "general",
        "info": "Glacial Erratic (need location of 1): Long Island was formed during the last ice age, approximately 20,000 years ago. As glaciers pushed forward and melted, they left behind terminal moraines – ridges of rock, dirt, and sand that formed at the outermost edge of the glaciers, marking the farthest point the glaciers advanced before melting. These moraines formed the bedrock of our island. This large boulder – called a glacial erratic – is a remnant of one of these glacial moraines. See if you can find others along our trails and on our beach!",
        "url": null,
        "icon": "trailhead.svg"
      },
      "geometry": {
        "type": "Point",
        "coordinates": [-73.6962452671523, 40.8611442404133]
      }
    },
