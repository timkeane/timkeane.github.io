    {
      "type": "Feature",
      "properties": {
        "name": "Castle Gould",
        "category": "building",
        "info": "Designed by architect Augustus N. Allen in 1902, and modeled after Ireland’s Kilkenny\nCastle, this 100,000-square-foot castle served as the Goulds’ and then the Guggenheims’\nstables, carriage house, and servants’ quarters. Today, in Castle Gould, visitors can find\nbathrooms, the Great Hall, the Sands Point Preserve Navy Simulation Museum, and the\nWelcome Center &amp; Gift Shop. Visit \u003Ca href=\"https://www.sandspointpreserveconservancy.org/about/castle-gould/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ECastle Gould\u003C/a\u003E for more information.",
        "url": null,
        "icon": null
