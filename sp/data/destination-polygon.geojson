{ "type": "Feature", "properties": { "name": "Hempstead House", "category": "General", "info": "Designed by architects Hunt &amp; Hunt in 1912, this 50,000-square-foot, three-story\nmansion has 40 rooms and a 60-foot-tall entry foyer. It served as the Guggenheims’ summer\nresidence (1917-1942) and the Naval Training Device Center’s dormitories and laboratories\n(1946-1967). Today, visitors can attend a range of cultural events in Hempstead House\nincluding concerts, multi-cultural holiday celebrations, Princess Days at the Castle, history\ntours, and galas. Tours are offered on select Wednesdays and Sundays throughout the year.\nPlease check our calendar for specific event dates. Visit <a href=\"https://www.sandspointpreserveconservancy.org/about/hempstead-house/\">Hempstead House</a> for more information.", "url": null }, "geometry": { "type": "Polygon", "coordinates": [ [ [ -73.7008357, 40.8630835 ], [ -73.7007742, 40.8631737 ], [ -73.7006631, 40.8631304 ], [ -73.7006146, 40.8632014 ], [ -73.7005357, 40.8631707 ], [ -73.7005727, 40.8631164 ], [ -73.7004269, 40.8630595 ], [ -73.7003165, 40.8632216 ], [ -73.7004521, 40.8632744 ], [ -73.7004633, 40.8632579 ], [ -73.7006211, 40.8633194 ], [ -73.700605, 40.8633432 ], [ -73.7006886, 40.8633758 ], [ -73.7006677, 40.8634064 ], [ -73.7008978, 40.8634961 ], [ -73.7009172, 40.8634677 ], [ -73.7010072, 40.8635027 ], [ -73.7010398, 40.8634549 ], [ -73.7010654, 40.8634649 ], [ -73.7010853, 40.8634356 ], [ -73.7010677, 40.8634287 ], [ -73.7011053, 40.8633735 ], [ -73.7011238, 40.8633807 ], [ -73.7011474, 40.8633462 ], [ -73.7011303, 40.8633395 ], [ -73.701166, 40.863287 ], [ -73.7009015, 40.8631838 ], [ -73.7009417, 40.8631248 ], [ -73.7008357, 40.8630835 ] ] ] } },
{ "type": "Feature", "properties": { "name": "Castle Gould", "category": "General", "info": "Designed by architect Augustus N. Allen in 1902, and modeled after Ireland’s Kilkenny\nCastle, this 100,000-square-foot castle served as the Goulds’ and then the Guggenheims’\nstables, carriage house, and servants’ quarters. Today, in Castle Gould, visitors can find\nbathrooms, the Great Hall, the Sands Point Preserve Navy Simulation Museum, and the\nWelcome Center &amp; Gift Shop. Visit <a href=\"https://www.sandspointpreserveconservancy.org/about/castle-gould/\" target=\"_blank\" rel=\"noopener noreferrer\">Castle Gould</a> for more information.", "url": null }, "geometry": { "type": "Polygon", "coordinates": [ [ [ -73.6975786, 40.8612663 ], [ -73.6973287, 40.8612859 ], [ -73.6972936, 40.8610304 ], [ -73.6970792, 40.8610473 ], [ -73.6971357, 40.8614594 ], [ -73.697754, 40.8614109 ], [ -73.6977729, 40.8614206 ], [ -73.6977974, 40.8614226 ], [ -73.69781, 40.8614183 ], [ -73.6978175, 40.8614157 ], [ -73.6978285, 40.8614078 ], [ -73.6978327, 40.8613977 ], [ -73.6978313, 40.8613849 ], [ -73.6978202, 40.8613719 ], [ -73.697822, 40.8613629 ], [ -73.6978294, 40.8613582 ], [ -73.6978234, 40.8613442 ], [ -73.6978055, 40.8613369 ], [ -73.69777, 40.8610767 ], [ -73.6978188, 40.861106 ], [ -73.6978599, 40.8611069 ], [ -73.6979063, 40.8610859 ], [ -73.6979213, 40.8610708 ], [ -73.6979425, 40.8610696 ], [ -73.6979473, 40.8611188 ], [ -73.6985069, 40.8610878 ], [ -73.6985225, 40.8610957 ], [ -73.6985634, 40.8610913 ], [ -73.6985769, 40.8610543 ], [ -73.6985483, 40.8610257 ], [ -73.698536, 40.8609362 ], [ -73.697544, 40.861014 ], [ -73.6975786, 40.8612663 ] ] ] } },
{ "type": "Feature", "properties": { "name": "Pond", "category": "General", "info": "Ponds are hotspots for biodiversity, supporting amphibians, insects, birds, and plants. In addition, the water in this pond drains out into a stream, which mixes with the surrounding plants and soil to create a marsh-like environment – yet another habitat at the Preserve!", "url": null }, "geometry": { "type": "Polygon", "coordinates": [ [ [ -73.696971513245046, 40.861835699755147 ], [ -73.697001753875909, 40.86183422422809 ], [ -73.697005005556647, 40.861833937320043 ], [ -73.697033295179097, 40.86183024850223 ], [ -73.697036221691747, 40.861830043567906 ], [ -73.697060609297282, 40.861830043567906 ], [ -73.697062722889768, 40.861830617383973 ], [ -73.697076379948882, 40.861840946073272 ], [ -73.697077680621177, 40.861842667521188 ], [ -73.697087435663391, 40.861863324894394 ], [ -73.697088790530358, 40.861865743118173 ], [ -73.697103423093679, 40.861888613773012 ], [ -73.69710472376596, 40.861891482850886 ], [ -73.697113503303967, 40.861920255597738 ], [ -73.697114587197547, 40.861923452568831 ], [ -73.697125317743996, 40.861952225301799 ], [ -73.697126455832247, 40.861954807469765 ], [ -73.697136210874447, 40.861972513760072 ], [ -73.697136861210595, 40.861974563098897 ], [ -73.697138812219052, 40.861993744907465 ], [ -73.697138432856292, 40.861995097470825 ], [ -73.697129653318299, 40.862000261802848 ], [ -73.697129273955554, 40.862000876604249 ], [ -73.697131224963996, 40.862006778697442 ], [ -73.697131821105458, 40.862007475472289 ], [ -73.697140600643465, 40.862014115326438 ], [ -73.697141847121074, 40.862014648154222 ], [ -73.697155504180174, 40.862017599200271 ], [ -73.697157184215214, 40.862017681173775 ], [ -73.697173767786978, 40.862016205650775 ], [ -73.697174472317812, 40.862016615518243 ], [ -73.697170570300926, 40.862025468655716 ], [ -73.697169757380735, 40.862026493324322 ], [ -73.697159026834314, 40.862036084221785 ], [ -73.697158515219044, 40.862037285020108 ], [