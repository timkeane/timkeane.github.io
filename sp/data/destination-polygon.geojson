{ "type": "Feature", "properties": { "name": "Learning Center & Outdoor Classroom", "category": "General", "info": "Originally a dog kennel for the Guggenheims, today the Learning Center is home to programs and activities for children of all ages. In 2011, the Outdoor Classroom was created, and the space was dedicated as the Phil Dejana Learning Center. The Outdoor Classroom is designed to foster a love of nature through exploration and play.", "url": null }, "geometry": { "type": "Polygon", "coordinates": [ [ [ -73.699358880655595, 40.860802474905498 ], [ -73.699364065894798, 40.860855103867898 ], [ -73.699110934078305, 40.860870007592297 ], [ -73.699105749074306, 40.8608173768204 ], [ -73.699358880655595, 40.860802474905498 ] ] ] } },
{ "type": "Feature", "properties": { "name": "Ice House Lounge", "category": "General", "info": "The walls of our Ice House Lounge are remnants of a storage space built in the 1950s by the U.S. Navy when they inhabited our grounds. By clearing debris, landscaping the surrounding area, and adding outdoor furniture and a tension sail roof, this space has been rehabilitated and repurposed as an outdoor lounge for visitors to relax in and enjoy. Visit <a href=\"https://www.sandspointpreserveconservancy.org/news/pond-revitalization-project/\" target=\"_blank\" rel=\"noopener noreferrer\">Pond Revitalization Project</a> for more information.", "url": null }, "geometry": { "type": "Polygon", "coordinates": [ [ [ -73.696613068493207, 40.861666377835803 ], [ -73.696604503029207, 40.861483557679598 ], [ -73.696715142621201, 40.861480554344602 ], [ -73.696723708389698, 40.861663374497297 ], [ -73.696613068493207, 40.861666377835803 ] ] ] } },
